generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum MachineType {
  EXCAVATOR          // Gravemaskin
  MINI_EXCAVATOR     // Minigraver
  WHEEL_LOADER       // Hjullaster
  ARTICULATED_HAULER // Dumper
  BULLDOZER          // Bulldoser
  MOTOR_GRADER       // Motorgrader
  COMPACTOR          // Komprimator / Valt
  TELEHANDLER        // Teleskoplaster
  CRANE              // Kran
  BACKHOE_LOADER     // Bakgraver
  SKID_STEER         // Kompaktlaster
  PIPELAYER          // Rørlegger
  FORKLIFT           // Gaffeltruck
  OTHER              // Annet
}

enum CustomerType {
  CONSUMER
  BUSINESS
}

enum OrderStatus {
  PENDING
  PAID
  INVOICED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  READY_FOR_PICKUP
  COLLECTED
}

enum OrderSource {
  ONLINE
  PHONE
}

enum UserRole {
  SUPER_ADMIN
  STORE_MANAGER
  FULFILLMENT_STAFF
}

enum BatchSlot {
  MORGEN
  ETTERMIDDAG
}

enum DiscountSource {
  NONE
  CUSTOMER_DISCOUNT
  PROMOTION
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionTargetType {
  PRODUCT
  CATEGORY
  BRAND
}

enum PromotionAudience {
  CONSUMER
  BUSINESS
  BOTH
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationType {
  ORDER_CONFIRMED
  PAYMENT_RECEIVED
  READY_FOR_PICKUP
  SHIPPED
  INVOICE_ISSUED
  LOW_STOCK
}

enum StocktakeStatus {
  OPEN
  IN_PROGRESS
  PENDING_REVIEW
  COMPLETED
}

enum ProductDraftStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductRequestStatus {
  PENDING
  IN_ENRICHMENT
  ADDED
  REJECTED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Profile {
  id                   String       @id @default(cuid())
  email                String       @unique
  fullName             String
  phoneNumber          String?
  customerType         CustomerType @default(CONSUMER)
  role                 UserRole?
  orgNumber            String?
  companyName          String?
  invoiceEmail         String?
  address              String?
  postalCode           String?
  city                 String?
  defaultDiscount      Decimal      @default(0)
  creditLimit          Decimal?
  isApprovedForInvoice Boolean      @default(false)
  isActive             Boolean      @default(true)
  preferredLanguage    String       @default("nb")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  storeStaff          StoreStaff[]
  salesAsCustomer     Sale[]            @relation("CustomerSales")
  salesByAdmin        Sale[]            @relation("AdminSales")
  priceHistoryChanges PriceHistory[]
  promotionsCreated   Promotion[]
  stockTransfers      StockTransfer[]
  stocktakeSessions   StocktakeSession[]
  stocktakeScans      StocktakeItem[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  draftReviews        ProductDraft[]    @relation("DraftReviewer")
  productRequests     ProductRequest[]
}

model Store {
  id                     String  @id @default(cuid())
  name                   String
  address                String
  postalCode             String
  city                   String
  phone                  String
  email                  String
  batchCutoffMorgen      String  @default("11:00")
  batchCutoffEttermiddag String  @default("15:00")
  isActive               Boolean @default(true)

  staff             StoreStaff[]
  stock             StoreStock[]
  sales             Sale[]
  transfersFrom     StockTransfer[]  @relation("TransferFrom")
  transfersTo       StockTransfer[]  @relation("TransferTo")
  stocktakeSessions StocktakeSession[]
}

model StoreStaff {
  id        String   @id @default(cuid())
  profileId String
  storeId   String
  role      UserRole

  profile Profile @relation(fields: [profileId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@unique([profileId, storeId])
}

model Category {
  id           String @id @default(cuid())
  name         String
  slug         String @unique
  parentId     String?
  displayOrder Int    @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Product {
  id                   String   @id @default(cuid())
  sku                  String   @unique
  partNumber           String?
  brand                String?
  name                 String
  shortDescription     String?
  fullDescription      Json?
  priceBase            Decimal
  mvaRate              Decimal  @default(0.25)
  minimumOrderQuantity Int      @default(1)
  leadTimeDays         Int      @default(0)
  weight               Int?
  dimensions           Json?
  mainImage            String?
  galleryImages           String[]
  barcodes                String[]
  replacesPartNumbers     String[]
  isActive             Boolean  @default(true)
  isDiscontinued       Boolean  @default(false)
  categoryId           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  category       Category?       @relation(fields: [categoryId], references: [id])
  stock          StoreStock[]
  saleItems      SaleItem[]
  priceHistory   PriceHistory[]
  stockTransfers StockTransfer[]
  stocktakeItems StocktakeItem[]
  fitments              ProductFitment[]
  fitmentProposals      FitmentProposal[]
  enrichmentProposal    ProductEnrichmentProposal?
}

// ─── Machine fitment ─────────────────────────────────────────────────────────

model MachineMake {
  id   String @id @default(cuid())
  name String @unique  // "Volvo CE", "Caterpillar", "Komatsu"
  slug String @unique  // "volvo-ce", "caterpillar", "komatsu"

  models MachineModel[]
}

model MachineModel {
  id       String      @id @default(cuid())
  makeId   String
  type     MachineType
  name     String      // "EC380", "L120H", "D6T"
  series   String?     // "EC-series", "L-series"
  yearFrom Int?
  yearTo   Int?        // null = still in production

  make             MachineMake      @relation(fields: [makeId], references: [id], onDelete: Cascade)
  fitments         ProductFitment[]
  fitmentProposals FitmentProposal[]

  @@unique([makeId, name])
}

model ProductFitment {
  id        String  @id @default(cuid())
  productId String
  modelId   String
  notes     String? // e.g. "Only for undercarriage serial A1234+"

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  model   MachineModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([productId, modelId])
}

model StoreStock {
  id                String  @id @default(cuid())
  productId         String
  storeId           String
  quantity          Int     @default(0)
  shelfLocation     String? // legacy free-text (kept for compatibility)
  locationCode      String? // structured hierarchical code: ZONE-AISLE-RACK-SHELF-SLOT
                            // e.g. "PLUKK-A-01-B-03" or "HØYLAGER-B-05-C-02"
  lowStockThreshold Int     @default(5)

  product Product @relation(fields: [productId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@unique([productId, storeId])
  @@unique([storeId, locationCode]) // one product per physical slot per store; NULLs are exempt
}

model PriceHistory {
  id          String   @id @default(cuid())
  productId   String
  oldPrice    Decimal
  newPrice    Decimal
  changedById String
  reason      String
  createdAt   DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id])
  changedBy Profile @relation(fields: [changedById], references: [id])
}

model Promotion {
  id                    String              @id @default(cuid())
  name                  String
  description           String?
  discountType          DiscountType
  discountValue         Decimal
  targetType            PromotionTargetType
  targetId              String
  startsAt              DateTime
  endsAt                DateTime
  isActive              Boolean             @default(true)
  appliesToCustomerType PromotionAudience   @default(BOTH)
  createdById           String
  createdAt             DateTime            @default(now())

  createdBy Profile    @relation(fields: [createdById], references: [id])
  saleItems SaleItem[]
}

model Sale {
  id                String            @id @default(cuid())
  checkoutSessionId String
  customerId        String?
  createdByAdminId  String?
  storeId           String
  orderSource       OrderSource       @default(ONLINE)
  status            OrderStatus       @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  batchSlot         BatchSlot         @default(MORGEN)
  invoiceNumber     String?
  subtotalExclMva   Decimal
  mvaAmount         Decimal
  shippingCost      Decimal           @default(0)
  discountApplied   Decimal           @default(0)
  totalPrice        Decimal
  mvaLockedAt       DateTime?
  isPickup          Boolean           @default(false)
  trackingNumber    String?
  isManualOverride  Boolean           @default(false)
  kidNumber         String?
  shippingProductId String?           // Bring product code e.g. "PAKKE_TIL_HENTESTED"
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  paidAt            DateTime?
  invoiceDueDate    DateTime?
  shippedAt         DateTime?

  customer       Profile?       @relation("CustomerSales", fields: [customerId], references: [id])
  createdByAdmin Profile?       @relation("AdminSales", fields: [createdByAdminId], references: [id])
  store          Store          @relation(fields: [storeId], references: [id])
  items          SaleItem[]
  notifications  Notification[]
}

model SaleItem {
  id                    String         @id @default(cuid())
  saleId                String
  productId             String
  sku                   String
  productName           String
  quantity              Int
  unitPriceExclMva      Decimal
  mvaRate               Decimal
  lineTotalExclMva      Decimal
  lineTotalInclMva      Decimal
  isManualPriceOverride Boolean        @default(false)
  discountSource        DiscountSource @default(NONE)
  promotionId           String?
  discountPercentage    Decimal        @default(0)

  sale      Sale       @relation(fields: [saleId], references: [id])
  product   Product    @relation(fields: [productId], references: [id])
  promotion Promotion? @relation(fields: [promotionId], references: [id])
}

model StockTransfer {
  id              String   @id @default(cuid())
  fromStoreId     String
  toStoreId       String
  productId       String
  quantity        Int
  transferredById String
  reason          String
  createdAt       DateTime @default(now())

  fromStore     Store   @relation("TransferFrom", fields: [fromStoreId], references: [id])
  toStore       Store   @relation("TransferTo", fields: [toStoreId], references: [id])
  product       Product @relation(fields: [productId], references: [id])
  transferredBy Profile @relation(fields: [transferredById], references: [id])
}

model StocktakeSession {
  id          String          @id @default(cuid())
  storeId     String
  createdById String
  status      StocktakeStatus @default(OPEN)
  isBlind     Boolean         @default(false)
  startedAt   DateTime        @default(now())
  completedAt DateTime?

  store     Store           @relation(fields: [storeId], references: [id])
  createdBy Profile         @relation(fields: [createdById], references: [id])
  items     StocktakeItem[]
}

model StocktakeItem {
  id               String   @id @default(cuid())
  sessionId        String
  productId        String
  expectedQuantity Int
  countedQuantity  Int
  discrepancy      Int
  scannedById      String
  scannedAt        DateTime @default(now())

  session   StocktakeSession @relation(fields: [sessionId], references: [id])
  product   Product          @relation(fields: [productId], references: [id])
  scannedBy Profile          @relation(fields: [scannedById], references: [id])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String
  action        String
  targetType    String
  targetId      String
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  actor Profile @relation(fields: [actorId], references: [id])
}

// Monotonically increasing invoice counter, one row per calendar year.
// Atomic upsert ensures no two invoices share the same sequence number.
model InvoiceCounter {
  year    Int @id
  lastSeq Int @default(0)
}

model Notification {
  id          String              @id @default(cuid())
  profileId   String
  saleId      String?
  channel     NotificationChannel
  type        NotificationType
  sentAt      DateTime            @default(now())
  deliveredAt DateTime?
  payload     Json?

  profile Profile @relation(fields: [profileId], references: [id])
  sale    Sale?   @relation(fields: [saleId], references: [id])
}

/// A candidate product record produced by the enrichment pipeline.
/// Always requires admin approval (architecture rule #6) before it
/// becomes a live Product.
model ProductDraft {
  id             String             @id @default(cuid())
  scannedCode    String             // the raw code that triggered lookup
  suggestedSku   String?
  suggestedName  String?
  suggestedBrand String?
  suggestedDesc  String?
  suggestedImage String?            // URL or base64
  enrichmentData Json               // raw API responses keyed by source name
  sources        Json               // [{ source, field, value }]
  status         ProductDraftStatus @default(PENDING)
  notes          String?            // admin review notes
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())

  reviewedBy Profile?         @relation("DraftReviewer", fields: [reviewedById], references: [id])
  requests   ProductRequest[]
}

/// A customer or staff request for a product that was not found in the catalogue.
model ProductRequest {
  id            String               @id @default(cuid())
  scannedCode   String
  draftId       String?              // linked once enrichment has run
  requestedById String?              // null for anonymous/guest requests
  email         String?              // contact email for notification
  notes         String?
  status        ProductRequestStatus @default(PENDING)
  createdAt     DateTime             @default(now())
  notifiedAt    DateTime?            // when the customer was told it was added

  draft       ProductDraft? @relation(fields: [draftId], references: [id])
  requestedBy Profile?      @relation(fields: [requestedById], references: [id])
}

// ─── Fitment proposals (auto-generated, pending admin review) ────────────────

/// Fitment suggestions generated automatically by the enrichment pipeline.
/// Shown to the admin on the product edit page so they can accept or ignore.
model FitmentProposal {
  id           String   @id @default(cuid())
  productSku   String
  modelId      String
  confidence   String   // "high" | "medium" | "low"
  mentionCount Int      @default(1)
  sources      Json     // string[]
  createdAt    DateTime @default(now())

  product Product      @relation(fields: [productSku], references: [sku], onDelete: Cascade)
  model   MachineModel @relation(fields: [modelId],   references: [id],  onDelete: Cascade)

  @@unique([productSku, modelId])
}

// ─── Product data enrichment proposals (pending admin approval) ──────────────

/// Field-level enrichment suggestions for an existing product.
/// Generated by the enrichment pipeline after create/import.
/// Admin must explicitly accept or dismiss each suggestion — never auto-applied.
model ProductEnrichmentProposal {
  id             String   @id @default(cuid())
  productSku     String   @unique   // one pending set per product
  suggestedName  String?
  suggestedBrand String?
  suggestedDesc  String?
  suggestedImage String?
  sources        Json     // DraftField[]  — provenance per field
  enrichmentData Json     // raw API responses keyed by source name
  createdAt      DateTime @default(now())

  product Product @relation(fields: [productSku], references: [sku], onDelete: Cascade)
}


// ─── WebhookEvent (Phase 1 — idempotency for inbound webhooks) ──────────────

model WebhookEvent {
  id           String        @id @default(cuid())
  /// Provider identifier — "vipps", "mybring", etc.
  provider     String
  /// Provider's unique event identifier. For Vipps this is the
  /// idempotencyKey delivered with each webhook event.
  eventId      String
  receivedAt   DateTime      @default(now())
  processedAt  DateTime?
  status       WebhookStatus @default(RECEIVED)
  payload      Json
  errorMessage String?

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@index([provider, status])
}
