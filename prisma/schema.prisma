generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// â”€â”€â”€ Enums â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum MachineType {
  EXCAVATOR          // Gravemaskin
  MINI_EXCAVATOR     // Minigraver
  WHEEL_LOADER       // Hjullaster
  ARTICULATED_HAULER // Dumper
  BULLDOZER          // Bulldoser
  MOTOR_GRADER       // Motorgrader
  COMPACTOR          // Komprimator / Valt
  TELEHANDLER        // Teleskoplaster
  CRANE              // Kran
  BACKHOE_LOADER     // Bakgraver
  SKID_STEER         // Kompaktlaster
  PIPELAYER          // RÃ¸rlegger
  FORKLIFT           // Gaffeltruck
  OTHER              // Annet
}

enum CustomerType {
  CONSUMER
  BUSINESS
}

enum OrderStatus {
  PENDING
  AUTHORIZED      // Vipps reservation succeeded; awaiting dispatch (Phase 3)
  PAID            // Captured / paid in full
  INVOICED        // Invoice issued, awaiting bank payment
  REFUNDED        // Full or partial refund settled (Phase 3)
  CANCELLED       // Authorization cancelled or order voided pre-capture (Phase 3)
  AWAITING_STOCK  // Sale taken but stock backordered (Phase 3 / used by Phase 8 backorder workflow)
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  READY_FOR_PICKUP
  COLLECTED
}

enum OrderSource {
  ONLINE
  PHONE
}

enum UserRole {
  SUPER_ADMIN
  STORE_MANAGER
  FULFILLMENT_STAFF
}

enum BatchSlot {
  MORGEN
  ETTERMIDDAG
}

enum DiscountSource {
  NONE
  CUSTOMER_DISCOUNT
  PROMOTION
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionTargetType {
  PRODUCT
  CATEGORY
  BRAND
}

enum PromotionAudience {
  CONSUMER
  BUSINESS
  BOTH
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationType {
  ORDER_CONFIRMED
  PAYMENT_RECEIVED
  READY_FOR_PICKUP
  SHIPPED
  INVOICE_ISSUED
  LOW_STOCK
}

enum StocktakeStatus {
  OPEN
  IN_PROGRESS
  PENDING_REVIEW
  COMPLETED
}

enum ProductDraftStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Phase 7 — Returns + Quotes ──────────────────────────────────────────────

enum ReturnRequestStatus {
  PENDING        // Customer submitted, awaiting admin review
  APPROVED       // Admin approved; goods expected
  RECEIVED       // Goods arrived, refund pending
  REFUNDED       // Refund processed (full or partial)
  REJECTED       // Admin rejected the return
}

enum ReturnReason {
  WRONG_ITEM            // Customer received the wrong product
  DEFECTIVE             // Product arrived faulty (Forbrukerkjøpsloven §15-17)
  NOT_AS_DESCRIBED      // Mismatch vs storefront description
  DAMAGED_IN_TRANSIT    // Shipping damage
  CHANGED_MIND          // §22 Angrerett — 14-day cooling-off period
  OTHER
}

enum QuoteStatus {
  DRAFT         // Created but not sent
  SENT          // Emailed to the customer
  ACCEPTED      // Customer accepted — eligible for conversion
  REJECTED      // Customer declined
  EXPIRED       // Past validUntil
  CONVERTED     // Already turned into a Sale
}

enum ProductRequestStatus {
  PENDING
  IN_ENRICHMENT
  ADDED
  REJECTED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum BackupRunStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED        // no SUPER_ADMIN with backupPublicKey set
}

enum ProductCondition {
  NEW
  USED
}

enum ConditionRating {
  AS_NEW         // Som ny â€” minimal use, no visible wear
  EXCELLENT      // Utmerket â€” light cosmetic wear, full function
  GOOD           // God â€” visible wear, full function
  FAIR           // Akseptabel â€” significant wear, full function
  POOR           // Slitt â€” heavy wear, function verified
}

enum PartProvenance {
  GENUINE        // Originaldeler
  OEM            // OEM-deler
  AFTERMARKET    // Uoriginale deler / Aftermarket
}

// â”€â”€â”€ Models â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Profile {
  id                   String       @id @default(cuid())
  email                String       @unique
  fullName             String
  phoneNumber          String?
  customerType         CustomerType @default(CONSUMER)
  role                 UserRole?
  orgNumber            String?
  companyName          String?
  invoiceEmail         String?
  address              String?
  postalCode           String?
  city                 String?
  defaultDiscount      Decimal      @default(0)
  creditLimit          Decimal?
  isApprovedForInvoice Boolean      @default(false)
  isActive             Boolean      @default(true)
  preferredLanguage    String       @default("nb")
  // ─── Phase 4.5 backup MVP ────────────────────────────────────────────────
  // age public key (X25519, "age1…"). Set during /admin/backup/setup; the
  // matching private key is downloaded once and never persisted.
  backupPublicKey      String?
  // Timestamp of the most recent successful backup download.
  lastBackupAt         DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  storeStaff          StoreStaff[]
  salesAsCustomer     Sale[]            @relation("CustomerSales")
  salesByAdmin        Sale[]            @relation("AdminSales")
  priceHistoryChanges PriceHistory[]
  promotionsCreated   Promotion[]
  stockTransfers      StockTransfer[]
  stocktakeSessions   StocktakeSession[]
  stocktakeScans      StocktakeItem[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  draftReviews        ProductDraft[]    @relation("DraftReviewer")
  productRequests     ProductRequest[]
  savedMachines       SavedMachine[]
  returnRequests      ReturnRequest[]    @relation("CustomerReturns")
  quotes              Quote[]            @relation("CustomerQuotes")
}

model Store {
  id                     String  @id @default(cuid())
  name                   String
  address                String
  postalCode             String
  city                   String
  phone                  String
  email                  String
  batchCutoffMorgen      String  @default("11:00")
  batchCutoffEttermiddag String  @default("15:00")
  isActive               Boolean @default(true)

  staff             StoreStaff[]
  stock             StoreStock[]
  sales             Sale[]
  transfersFrom     StockTransfer[]    @relation("TransferFrom")
  transfersTo       StockTransfer[]    @relation("TransferTo")
  stocktakeSessions StocktakeSession[]
  reservations      StockReservation[]
  quotes            Quote[]
}

model StoreStaff {
  id        String   @id @default(cuid())
  profileId String
  storeId   String
  role      UserRole

  profile Profile @relation(fields: [profileId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@unique([profileId, storeId])
}

model Category {
  id           String @id @default(cuid())
  name         String
  slug         String @unique
  parentId     String?
  displayOrder Int    @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Product {
  id                   String   @id @default(cuid())
  sku                  String   @unique
  partNumber           String?
  brand                String?
  name                 String
  shortDescription     String?
  fullDescription      Json?
  priceBase            Decimal
  mvaRate              Decimal  @default(0.25)
  minimumOrderQuantity Int      @default(1)
  leadTimeDays         Int      @default(0)
  weight               Int?
  dimensions           Json?
  mainImage            String?
  galleryImages           String[]
  barcodes                String[]
  replacesPartNumbers     String[]
  isActive             Boolean  @default(true)
  isDiscontinued       Boolean  @default(false)
  categoryId           String?
  // â”€â”€â”€ Condition + provenance (Phase 0.7) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  condition       ProductCondition @default(NEW)
  conditionRating ConditionRating?    // required at app layer when condition = USED
  conditionNotes  String?
  provenance      PartProvenance   @default(AFTERMARKET)
  // ─── Admin-only metadata (NEVER exposed via storefront PRODUCT_SELECT) ───
  // purchasePrice:     cost-of-goods-sold. Used for margin reports and
  //                    profitability dashboards. Storefront never sees it.
  // tags:              free-form internal categorisation. Searchable by
  //                    admins; never rendered on the public PDP.
  // hiddenDescription: internal notes about the product (supplier quirks,
  //                    warranty caveats, picking instructions). Admin only.
  purchasePrice     Decimal?
  tags              String[]
  hiddenDescription String?
  // ─── Phase 5 search columns ──────────────────────────────────────────────
  // Maintained by DB trigger; do not write from app code.
  //   searchKey:    lowercase, dashes/spaces stripped from sku+partNumber+
  //                 name for exact + trigram matching.
  //   searchVector: tsvector built from name / sku / partNumber / brand
  //                 for FTS rank.
  searchKey            String?
  searchVector         Unsupported("tsvector")?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  category       Category?       @relation(fields: [categoryId], references: [id])
  stock          StoreStock[]
  saleItems      SaleItem[]
  priceHistory   PriceHistory[]
  stockTransfers StockTransfer[]
  stocktakeItems StocktakeItem[]
  reservations   StockReservation[]
  fitments              ProductFitment[]
  fitmentProposals      FitmentProposal[]
  enrichmentProposal    ProductEnrichmentProposal?
  quoteItems            QuoteItem[]
}

// â”€â”€â”€ Machine fitment â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model MachineMake {
  id   String @id @default(cuid())
  name String @unique  // "Volvo CE", "Caterpillar", "Komatsu"
  slug String @unique  // "volvo-ce", "caterpillar", "komatsu"

  models MachineModel[]
}

model MachineModel {
  id       String      @id @default(cuid())
  makeId   String
  type     MachineType
  name     String      // "EC380", "L120H", "D6T"
  series   String?     // "EC-series", "L-series"
  yearFrom Int?
  yearTo   Int?        // null = still in production

  make             MachineMake      @relation(fields: [makeId], references: [id], onDelete: Cascade)
  fitments         ProductFitment[]
  fitmentProposals FitmentProposal[]
  savedMachines    SavedMachine[]

  @@unique([makeId, name])
}

model ProductFitment {
  id        String  @id @default(cuid())
  productId String
  modelId   String
  notes     String? // e.g. "Only for undercarriage serial A1234+"

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  model   MachineModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([productId, modelId])
}

model StoreStock {
  id                String  @id @default(cuid())
  productId         String
  storeId           String
  quantity          Int     @default(0)
  shelfLocation     String? // legacy free-text (kept for compatibility)
  locationCode      String? // structured hierarchical code: ZONE-AISLE-RACK-SHELF-SLOT
                            // e.g. "PLUKK-A-01-B-03" or "HÃ˜YLAGER-B-05-C-02"
  lowStockThreshold Int     @default(5)

  product Product @relation(fields: [productId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@unique([productId, storeId])
  @@unique([storeId, locationCode]) // one product per physical slot per store; NULLs are exempt
}

model PriceHistory {
  id          String   @id @default(cuid())
  productId   String
  oldPrice    Decimal
  newPrice    Decimal
  changedById String
  reason      String
  createdAt   DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id])
  changedBy Profile @relation(fields: [changedById], references: [id])
}

model Promotion {
  id                    String              @id @default(cuid())
  name                  String
  description           String?
  discountType          DiscountType
  discountValue         Decimal
  targetType            PromotionTargetType
  targetId              String
  startsAt              DateTime
  endsAt                DateTime
  isActive              Boolean             @default(true)
  appliesToCustomerType PromotionAudience   @default(BOTH)
  createdById           String
  createdAt             DateTime            @default(now())

  createdBy Profile    @relation(fields: [createdById], references: [id])
  saleItems SaleItem[]
}

model Sale {
  id                String            @id @default(cuid())
  checkoutSessionId String
  customerId        String?
  createdByAdminId  String?
  storeId           String
  orderSource       OrderSource       @default(ONLINE)
  status            OrderStatus       @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  batchSlot         BatchSlot         @default(MORGEN)
  invoiceNumber     String?
  subtotalExclMva   Decimal
  mvaAmount         Decimal
  shippingCost      Decimal           @default(0)
  discountApplied   Decimal           @default(0)
  totalPrice        Decimal
  mvaLockedAt       DateTime?
  isPickup          Boolean           @default(false)
  trackingNumber    String?
  isManualOverride  Boolean           @default(false)
  kidNumber         String?
  shippingProductId String?           // Bring product code e.g. "PAKKE_TIL_HENTESTED"
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  paidAt            DateTime?
  invoiceDueDate    DateTime?
  shippedAt         DateTime?
  // ─── Phase 3: Vipps capture-on-dispatch ─────────────────────────────────
  vippsReference    String?           // Vipps payment reference; mirrors checkoutSessionId today, kept distinct so future capture-only reconciliation has a stable handle
  authorizedAt      DateTime?         // When Vipps confirmed AUTHORIZED via webhook
  capturedAt        DateTime?         // When captureSaleOnDispatch completed
  capturedAmount    Decimal?          // Amount actually captured (may differ from totalPrice if partial fulfilment)

  customer        Profile?           @relation("CustomerSales", fields: [customerId], references: [id])
  createdByAdmin  Profile?           @relation("AdminSales", fields: [createdByAdminId], references: [id])
  store           Store              @relation(fields: [storeId], references: [id])
  items           SaleItem[]
  notifications   Notification[]
  reservations    StockReservation[]
  returnRequests  ReturnRequest[]
  convertedFromQuote Quote?          @relation("ConvertedQuote")
}

model SaleItem {
  id                    String         @id @default(cuid())
  saleId                String
  productId             String
  sku                   String
  productName           String
  quantity              Int
  unitPriceExclMva      Decimal
  mvaRate               Decimal
  lineTotalExclMva      Decimal
  lineTotalInclMva      Decimal
  isManualPriceOverride Boolean        @default(false)
  discountSource        DiscountSource @default(NONE)
  promotionId           String?
  discountPercentage    Decimal        @default(0)

  sale        Sale         @relation(fields: [saleId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])
  promotion   Promotion?   @relation(fields: [promotionId], references: [id])
  returnItems ReturnItem[]
}

// ─── Phase 7 — Returns ──────────────────────────────────────────────────────

model ReturnRequest {
  id                   String              @id @default(cuid())
  saleId               String
  customerId           String?
  reason               ReturnReason
  notes                String?             // free-text from the customer
  adminNotes           String?             // internal review notes
  status               ReturnRequestStatus @default(PENDING)
  refundAmount         Decimal?            // amount refunded (may be partial)
  vippsRefundReference String?             // Vipps refund psp reference

  createdAt            DateTime            @default(now())
  approvedAt           DateTime?
  receivedAt           DateTime?
  refundedAt           DateTime?
  rejectedAt           DateTime?

  sale     Sale         @relation(fields: [saleId], references: [id])
  customer Profile?     @relation("CustomerReturns", fields: [customerId], references: [id])
  items    ReturnItem[]

  @@index([saleId])
  @@index([customerId])
  @@index([status, createdAt])
}

model ReturnItem {
  id              String  @id @default(cuid())
  returnRequestId String
  saleItemId      String
  quantity        Int

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  saleItem      SaleItem      @relation(fields: [saleItemId], references: [id])

  @@unique([returnRequestId, saleItemId])
}

// ─── Phase 7 — Quotes ───────────────────────────────────────────────────────
//
// Quotes are pre-sale price proposals — typically B2B "Be om tilbud" flow.
// Line snapshots match SaleItem so converting to a Sale is a pure copy.
// Auto-numbered "Q-YYYY-NNNNNN" via a counter row in InvoiceCounter (or a
// sibling pattern; for v1 we use a simple year+sequence string).
model Quote {
  id              String      @id @default(cuid())
  quoteNumber     String      @unique
  customerId      String?
  customerEmail   String
  customerName    String?
  customerCompany String?
  storeId         String
  status          QuoteStatus @default(DRAFT)
  subtotalExclMva Decimal
  mvaAmount       Decimal
  totalPrice      Decimal
  validUntil      DateTime?
  notes           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sentAt          DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  convertedSaleId String?   @unique // FK -> Sale once the quote becomes an order

  customer        Profile?  @relation("CustomerQuotes", fields: [customerId], references: [id])
  store           Store     @relation(fields: [storeId], references: [id])
  items           QuoteItem[]
  convertedSale   Sale?     @relation("ConvertedQuote", fields: [convertedSaleId], references: [id])

  @@index([status, createdAt])
}

model QuoteItem {
  id               String  @id @default(cuid())
  quoteId          String
  productId        String
  sku              String
  productName      String  // snapshot
  quantity         Int
  unitPriceExclMva Decimal
  mvaRate          Decimal
  lineTotalExclMva Decimal
  lineTotalInclMva Decimal

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model StockTransfer {
  id              String   @id @default(cuid())
  fromStoreId     String
  toStoreId       String
  productId       String
  quantity        Int
  transferredById String
  reason          String
  createdAt       DateTime @default(now())

  fromStore     Store   @relation("TransferFrom", fields: [fromStoreId], references: [id])
  toStore       Store   @relation("TransferTo", fields: [toStoreId], references: [id])
  product       Product @relation(fields: [productId], references: [id])
  transferredBy Profile @relation(fields: [transferredById], references: [id])
}

// ─── Stock reservations (Phase 3) ─────────────────────────────────────────
//
// One row per (sale, product, store) at checkout. Soft-holds stock for the
// payment window. Released on capture/cancel/expiry. The cron sweep at
// /api/jobs/expire-reservations deletes rows past expiresAt.
model StockReservation {
  id        String   @id @default(cuid())
  saleId    String?  // null while in PENDING (no Sale row yet); filled once Sale exists
  productId String
  storeId   String
  quantity  Int
  sessionId String   // Sale.checkoutSessionId — survives across PENDING → AUTHORIZED → CAPTURED
  expiresAt DateTime
  createdAt DateTime @default(now())

  sale    Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)
  product Product @relation(fields: [productId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@index([productId, storeId, expiresAt])
  @@index([sessionId])
  @@index([expiresAt])
}

model StocktakeSession {
  id          String          @id @default(cuid())
  storeId     String
  createdById String
  status      StocktakeStatus @default(OPEN)
  isBlind     Boolean         @default(false)
  startedAt   DateTime        @default(now())
  completedAt DateTime?

  store     Store           @relation(fields: [storeId], references: [id])
  createdBy Profile         @relation(fields: [createdById], references: [id])
  items     StocktakeItem[]
}

model StocktakeItem {
  id               String   @id @default(cuid())
  sessionId        String
  productId        String
  expectedQuantity Int
  countedQuantity  Int
  discrepancy      Int
  scannedById      String
  scannedAt        DateTime @default(now())

  session   StocktakeSession @relation(fields: [sessionId], references: [id])
  product   Product          @relation(fields: [productId], references: [id])
  scannedBy Profile          @relation(fields: [scannedById], references: [id])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String
  action        String
  targetType    String
  targetId      String
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  actor Profile @relation(fields: [actorId], references: [id])
}

// Monotonically increasing invoice counter, one row per calendar year.
// Atomic upsert ensures no two invoices share the same sequence number.
model InvoiceCounter {
  year    Int @id
  lastSeq Int @default(0)
}

model Notification {
  id          String              @id @default(cuid())
  profileId   String
  saleId      String?
  channel     NotificationChannel
  type        NotificationType
  sentAt      DateTime            @default(now())
  deliveredAt DateTime?
  payload     Json?

  profile Profile @relation(fields: [profileId], references: [id])
  sale    Sale?   @relation(fields: [saleId], references: [id])
}

/// A candidate product record produced by the enrichment pipeline.
/// Always requires admin approval (architecture rule #6) before it
/// becomes a live Product.
model ProductDraft {
  id             String             @id @default(cuid())
  scannedCode    String             // the raw code that triggered lookup
  suggestedSku   String?
  suggestedName  String?
  suggestedBrand String?
  suggestedDesc  String?
  suggestedImage String?            // URL or base64
  enrichmentData Json               // raw API responses keyed by source name
  sources        Json               // [{ source, field, value }]
  status         ProductDraftStatus @default(PENDING)
  notes          String?            // admin review notes
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())

  reviewedBy Profile?         @relation("DraftReviewer", fields: [reviewedById], references: [id])
  requests   ProductRequest[]
}

/// A customer or staff request for a product that was not found in the catalogue.
model ProductRequest {
  id            String               @id @default(cuid())
  scannedCode   String
  draftId       String?              // linked once enrichment has run
  requestedById String?              // null for anonymous/guest requests
  email         String?              // contact email for notification
  notes         String?
  status        ProductRequestStatus @default(PENDING)
  createdAt     DateTime             @default(now())
  notifiedAt    DateTime?            // when the customer was told it was added

  draft       ProductDraft? @relation(fields: [draftId], references: [id])
  requestedBy Profile?      @relation(fields: [requestedById], references: [id])
}

// â”€â”€â”€ Fitment proposals (auto-generated, pending admin review) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// Fitment suggestions generated automatically by the enrichment pipeline.
/// Shown to the admin on the product edit page so they can accept or ignore.
model FitmentProposal {
  id           String   @id @default(cuid())
  productSku   String
  modelId      String
  confidence   String   // "high" | "medium" | "low"
  mentionCount Int      @default(1)
  sources      Json     // string[]
  createdAt    DateTime @default(now())

  product Product      @relation(fields: [productSku], references: [sku], onDelete: Cascade)
  model   MachineModel @relation(fields: [modelId],   references: [id],  onDelete: Cascade)

  @@unique([productSku, modelId])
}

// â”€â”€â”€ Product data enrichment proposals (pending admin approval) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// Field-level enrichment suggestions for an existing product.
/// Generated by the enrichment pipeline after create/import.
/// Admin must explicitly accept or dismiss each suggestion â€” never auto-applied.
model ProductEnrichmentProposal {
  id             String   @id @default(cuid())
  productSku     String   @unique   // one pending set per product
  suggestedName  String?
  suggestedBrand String?
  suggestedDesc  String?
  suggestedImage String?
  sources        Json     // DraftField[]  â€” provenance per field
  enrichmentData Json     // raw API responses keyed by source name
  createdAt      DateTime @default(now())

  product Product @relation(fields: [productSku], references: [sku], onDelete: Cascade)
}


// â”€â”€â”€ WebhookEvent (Phase 1 â€” idempotency for inbound webhooks) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model WebhookEvent {
  id           String        @id @default(cuid())
  /// Provider identifier â€” "vipps", "mybring", etc.
  provider     String
  /// Provider's unique event identifier. For Vipps this is the
  /// idempotencyKey delivered with each webhook event.
  eventId      String
  receivedAt   DateTime      @default(now())
  processedAt  DateTime?
  status       WebhookStatus @default(RECEIVED)
  payload      Json
  errorMessage String?

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@index([provider, status])
}


// ─── SavedMachine (Phase 0.7) ────────────────────────────────────────────────

/// A user's "favourite machine" pinned for one-click filtering on
/// storefront listings. Owned by a Profile, references a MachineModel.
model SavedMachine {
  id           String   @id @default(cuid())
  profileId    String
  modelId      String
  /// Optional nickname, e.g. "Min EC380 fra 2022"
  label        String?
  /// Optional serial number for warranty / fitment specificity
  serialNumber String?
  createdAt    DateTime @default(now())

  profile Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  model   MachineModel @relation(fields: [modelId], references: [id])

  @@unique([profileId, modelId])
  @@index([profileId])
}


// ─── BackupRun (Phase 4.5 follow-up — automatic daily backup) ────────────────

/// One row per scheduled or manual backup attempt. The `maintenance`
/// queue's `daily-backup` job writes a row on every tick (status RUNNING),
/// then mutates to SUCCESS/FAILED/SKIPPED on completion.
///
/// The actual encrypted artifact lives in Supabase Storage at
/// `storagePath`; this model is only metadata + audit trail.
model BackupRun {
  id           String          @id @default(cuid())
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  status       BackupRunStatus @default(RUNNING)
  /// Truncated age recipient (first 20 chars) so we can tell which
  /// admin's key the artifact was encrypted to without leaking the
  /// full key into logs.
  recipientKey String?
  /// Path in Supabase Storage. Null for FAILED/SKIPPED runs.
  storagePath  String?
  /// Bytes of the encrypted artifact. Null until SUCCESS.
  bytesWritten Int?
  /// Human-readable failure reason for FAILED and SKIPPED runs.
  errorMessage String?

  @@index([startedAt])
  @@index([status])
}