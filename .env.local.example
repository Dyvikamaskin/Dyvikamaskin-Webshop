# Copy to .env.local for local development.
# .env.local is gitignored — never commit it.
# Values here override .env (which holds Supabase prod defaults).

# ── OEM database ──────────────────────────────────────────────────────────────
# While building / exploring locally (local PostgreSQL 18):
OEM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oem_catalog
OEM_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/oem_catalog

# When pointing at Supabase OEM prod (BojoIndAI1 org, project rtzcrngduscrhgozrojv):
# OEM_DATABASE_URL=postgresql://postgres.rtzcrngduscrhgozrojv:<password>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
# OEM_DIRECT_URL=postgresql://postgres.rtzcrngduscrhgozrojv:<password>@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
