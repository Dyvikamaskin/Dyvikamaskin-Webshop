# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL — use direct connection (port 5432) for migrations.
# Restore DATABASE_URL to the pooler URL (port 6543, pgbouncer=true) for prod runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found at: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]

# ─── App ──────────────────────────────────────────────────────────────────────
# Must be the publicly accessible URL (https) for Vipps return/webhook URLs.
# For local testing with Vipps: use ngrok (https://ngrok.com) and set ngrok URL here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_CATEGORY_DEPTH=4

# ─── Upstash Redis (rate limiting) ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://[database].upstash.io
UPSTASH_REDIS_REST_TOKEN=[token]

# ─── Sentry ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://[key]@[org].ingest.de.sentry.io/[project-id]

# ─── Cron jobs ────────────────────────────────────────────────────────────────
# Sent in x-cron-secret header to protect /api/jobs/* endpoints
CRON_SECRET=

# ─── Vipps ePayment ───────────────────────────────────────────────────────────
# Get credentials from: portal.vipps.no → Sales Units → [your unit] → Keys
#
# VIPPS_CLIENT_ID           — "client_id" field in the portal
# VIPPS_CLIENT_SECRET       — "client_secret" field in the portal
# VIPPS_MERCHANT_SERIAL_NUMBER — "merchantSerialNumber" (MSN) for the sale unit
# VIPPS_SUBSCRIPTION_KEY    — "Ocp-Apim-Subscription-Key" (Primary key)
# VIPPS_WEBHOOK_SECRET      — returned when you register a webhook via /admin/vipps
#
# Test vs production:
#   Test:       set VIPPS_API_BASE_URL=https://apitest.vipps.no
#               get test credentials from portal.vipps.no → Test sale units
#   Production: leave VIPPS_API_BASE_URL blank (defaults to https://api.vipps.no)
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_MERCHANT_SERIAL_NUMBER=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_WEBHOOK_SECRET=
VIPPS_API_BASE_URL=https://apitest.vipps.no

# ─── MyBring / Bring (shipping) ───────────────────────────────────────────────
# Get from: mybring.com → API (requires shipping agreement with Bring)
MYBRING_API_ID=
MYBRING_API_KEY=
MYBRING_CUSTOMER_NUMBER=

# ─── Resend (transactional email) ─────────────────────────────────────────────
# Get API key from: resend.com → API Keys
# Also verify your sending domain under resend.com → Domains
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@dindomene.no

# ─── SMS ──────────────────────────────────────────────────────────────────────
# Set SMS_PROVIDER to one of: sveve | gatewayapi | 46elks
# Leave blank to disable SMS (noop — safe for development).
SMS_PROVIDER=
SMS_SENDER=DyvikaMaskin

# Sveve.no (Norwegian provider — simple user/password auth)
SVEVE_USER=
SVEVE_PASSWD=

# GatewayAPI (EU provider — bearer token)
GATEWAYAPI_TOKEN=

# 46elks (EU provider — HTTP Basic auth)
ELKS_USERNAME=
ELKS_PASSWORD=

# ─── Invoice & company details ────────────────────────────────────────────────
# Used on invoice PDFs and B2B invoice emails
COMPANY_BANK_ACCOUNT=xxxx.xx.xxxxx
COMPANY_ORG_NUMBER=123456789
