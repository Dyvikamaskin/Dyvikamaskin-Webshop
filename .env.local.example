# ─── Database ────────────────────────────────────────────────────────────────
# Supabase PostgreSQL via Prisma (driver adapter required)
# Use direct connection (port 5432) — pgbouncer pooler causes migrate dev to hang
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key-from-supabase-settings-api]
SUPABASE_SERVICE_ROLE_KEY=[service-role-key-from-supabase-settings-api]

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_CATEGORY_DEPTH=4

# ─── Upstash Redis (rate limiting) ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://[database].upstash.io
UPSTASH_REDIS_REST_TOKEN=[token]

# ─── Sentry ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://[key]@[org].ingest.de.sentry.io/[project-id]

# ─── Vipps ePayment (Phase 7) ────────────────────────────────────────────────
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_MERCHANT_SERIAL_NUMBER=
VIPPS_SUBSCRIPTION_KEY=

# ─── MyBring / Bring (Phase 9) ───────────────────────────────────────────────
MYBRING_API_ID=
MYBRING_API_KEY=
MYBRING_CUSTOMER_NUMBER=

# ─── Resend (Phase 13) ───────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── SMS (Phase 13 — set SMS_PROVIDER to: sveve | gatewayapi | 46elks) ──────
SMS_PROVIDER=sveve
SVEVE_API_TOKEN=
SVEVE_DEFAULT_SENDER=Dyvikamaskin
